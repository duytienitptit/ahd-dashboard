# Kết quả kiểm chứng M0 — chứa access/refresh token thật
tools/m0-display-api-probe/out/

# Dữ liệu thật — không commit gì trong data/ ngoại trừ README và file .example.*
data/*
!data/README.md
!data/samples/
data/samples/*
!data/samples/*.example.*
