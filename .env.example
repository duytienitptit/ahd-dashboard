# Sao chép thành .env.local rồi điền giá trị thật. KHÔNG commit .env.local.

# ── Supabase ─────────────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Chỉ dùng ở server (route handler, cron). Không bao giờ để lộ ra client.
SUPABASE_SERVICE_ROLE_KEY=

# ── TikTok Display API ───────────────────────────────────────────────────
# Lấy từ developers.tiktok.com sau khi tạo app. Xem docs/DISPLAY_API.md
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
# Phải khớp CHÍNH XÁC redirect URI đã khai báo trong app TikTok.
# ⚠️ Đã kiểm chứng: TikTok từ chối MỌI dạng localhost, kể cả https://localhost — không có
# ngoại lệ cho dev. Phải dùng domain thật đã deploy (vd. *.vercel.app), kể cả lúc test —
# route đích chưa tồn tại thì vẫn nhảy tới và trả 404, code vẫn nằm trên query string, copy
# dùng bình thường. Xem tools/m0-display-api-probe/README.md.
TIKTOK_REDIRECT_URI=https://ahd-dashboard-dusky.vercel.app/api/oauth/callback

# ── Mã hoá token ─────────────────────────────────────────────────────────
# Khoá AES-256-GCM mã hoá access/refresh token trước khi ghi vào channel_oauth (lib/crypto/token.ts).
# Sinh khoá: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# ⚠️ Đổi khoá này = mọi token đã lưu không giải mã được nữa, phải OAuth lại 8 kênh.
TOKEN_ENCRYPTION_KEY=

# ── Cron ─────────────────────────────────────────────────────────────────
# Chuỗi bí mật để chặn người ngoài gọi endpoint đồng bộ. Vercel Cron gửi kèm header.
CRON_SECRET=

# ── Ứng dụng ─────────────────────────────────────────────────────────────
# Múi giờ chuẩn — mọi cột `date` hiểu theo lịch múi giờ này. Xem docs/DATABASE_ERD.md
APP_TIMEZONE=Asia/Ho_Chi_Minh

# ── Seed (chỉ dùng khi chạy `npm run seed`, không cần trên Vercel) ────────
# Tài khoản Manager đầu tiên. Không có self-signup nên phải tạo bằng script này.
SEED_MANAGER_EMAIL=
SEED_MANAGER_PASSWORD=
SEED_MANAGER_NAME=
# Mật khẩu tạm cho các tài khoản Creator trong data/samples/channels_seed.csv.
# Chỉ cần khi file CSV đó có cột creator_email. Đổi mật khẩu ngay sau khi bàn giao.
SEED_CREATOR_DEFAULT_PASSWORD=
